# DeepSeek Web Bridge configuration.
# Copy this file to .env and change values only if you need to.

# HTTP listen address. Keep 127.0.0.1 (loopback) by default.
# If you set a non-loopback HOST, a PROXY_API_KEY of at least 24 chars is required.
HOST=127.0.0.1
PORT=9655

# Local API key for clients. On loopback it is optional; clients may send any dummy value.
# PROXY_API_KEY=

# Chrome executable path. Leave empty for automatic discovery.
# CHROME_PATH=

# Paths under ./data
# DS_DATA_DIR=./data
# DS_AUTH_FILE=./data/auth.json
# DS_SESSIONS_FILE=./data/sessions.json
# DS_CHROME_PROFILE=./data/chrome-profile

# Upstream
# DS_BASE_URL=https://chat.deepseek.com

# Diagnostics (safe logs only; never prints secrets)
# DS_DEBUG=false

# Allow additional browser origins for the setup UI, comma separated.
# PROXY_CORS_ORIGINS=
